generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN
  BAR
  INVENTORY_MANAGER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum DiningSessionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderSource {
  QR
  WAITER
  POS
}

enum PreparationStation {
  KITCHEN
  BAR
}

enum PreparationStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum BillStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum PaymentMethod {
  MPESA
  CASH
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountStatus {
  APPLIED
  REVERSED
}

model Restaurant {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  phone    String?
  email    String?
  isActive Boolean @default(true)

  memberships         Membership[]
  tables              RestaurantTable[]
  menuCategories      MenuCategory[]
  menuItems           MenuItem[]
  orders              Order[]
  bills               Bill[]
  payments            Payment[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  suppliers           Supplier[]
  stockMovements      StockMovement[]
  stockReceipts       StockReceipt[]
  discounts           Discount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  memberships     Membership[]
  refreshSessions RefreshSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id           String         @id @default(uuid())
  userId       String
  restaurantId String
  role         MembershipRole
  isActive     Boolean        @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, restaurantId])
  @@index([restaurantId, role])
}

model RestaurantTable {
  id           String      @id @default(uuid())
  restaurantId String
  tableNumber  String
  capacity     Int         @default(2)
  status       TableStatus @default(AVAILABLE)
  qrToken      String      @unique @default(uuid())

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessions   DiningSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId, status])
}

model DiningSession {
  id      String              @id @default(uuid())
  tableId String
  status  DiningSessionStatus @default(OPEN)

  orders Order[]

  startedAt DateTime        @default(now())
  closedAt  DateTime?
  bills     Bill[]
  table     RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@index([tableId, status])
}

model RefreshSession {
  id           String    @id @default(uuid())
  userId       String
  restaurantId String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([restaurantId])
}

model MenuCategory {
  id           String  @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
}

model MenuItem {
  id           String  @id @default(uuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  price        Decimal @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable  Boolean @default(true)

  restaurant        Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category          MenuCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems        OrderItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  station           PreparationStation @default(KITCHEN)
  recipeIngredients RecipeIngredient[]

  @@index([restaurantId, isAvailable])
  @@index([categoryId, isAvailable])
}

model Order {
  id           String      @id @default(uuid())
  restaurantId String
  sessionId    String
  orderNumber  String
  source       OrderSource @default(QR)
  status       OrderStatus @default(PENDING)

  notes    String?
  subtotal Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  session    DiningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  items      OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status, createdAt])
  @@index([sessionId, status])
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String?

  // Snapshots preserve what the customer ordered,
  // even if the menu item is later renamed or removed.
  itemName  String
  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int
  notes     String?
  lineTotal Decimal @db.Decimal(12, 2)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  createdAt         DateTime           @default(now())
  preparationStatus PreparationStatus  @default(PENDING)
  station           PreparationStation @default(KITCHEN)
  billItems         BillItem[]
  stockDeductions   StockDeduction[]

  @@index([orderId])
  @@index([menuItemId])
}

model Bill {
  id           String @id @default(uuid())
  restaurantId String
  sessionId    String

  billNumber String
  status     BillStatus @default(OPEN)

  subtotal   Decimal @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)
  amountPaid Decimal @default(0) @db.Decimal(12, 2)
  balance    Decimal @db.Decimal(12, 2)

  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  session        DiningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  discounts      Discount[]
  items          BillItem[]
  payments       Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, billNumber])
  @@index([restaurantId, status, createdAt])
  @@index([sessionId, status])
}

model Payment {
  id           String @id @default(uuid())
  restaurantId String
  billId       String

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  amount Decimal @db.Decimal(12, 2)

  idempotencyKey    String
  reference         String?
  transactionId     String?   @unique
  checkoutRequestId String?   @unique
  merchantRequestId String?
  darajaTimestamp   String?
  phoneNumber       String?
  failureReason     String?
  verifiedAt        DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  bill       Bill       @relation(fields: [billId], references: [id], onDelete: Restrict)

  callbackEvents PaymentCallbackEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, status, createdAt])
  @@index([billId, status])
}

model BillItem {
  id          String @id @default(uuid())
  billId      String
  orderItemId String

  itemName  String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  bill      Bill      @relation(fields: [billId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([billId, orderItemId])
  @@index([orderItemId])
}

model Discount {
  id           String @id @default(uuid())
  restaurantId String
  billId       String

  type   DiscountType
  value  Decimal      @db.Decimal(12, 2)
  amount Decimal      @db.Decimal(12, 2)
  reason String

  status DiscountStatus @default(APPLIED)

  approvedBy String
  appliedBy  String

  reversedBy     String?
  reversedAt     DateTime?
  reversalReason String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  bill       Bill       @relation(fields: [billId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, createdAt])
  @@index([billId, status])
  @@index([approvedBy])
  @@index([appliedBy])
}

model PaymentCallbackEvent {
  id                String  @id @default(uuid())
  paymentId         String?
  checkoutRequestId String

  resultCode String?
  resultDesc String?

  payload Json

  processingStatus String  @default("RECEIVED")
  processingError  String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([checkoutRequestId, receivedAt])
  @@index([paymentId, receivedAt])
  @@index([processingStatus, receivedAt])
}

enum InventoryUnit {
  KG
  G
  L
  ML
  PIECE
  PACKET
}

enum StockMovementType {
  RECEIPT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RECIPE_DEDUCTION
  WASTE
  RETURN
}

enum StockReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

model InventoryCategory {
  id           String  @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  isActive     Boolean @default(true)

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items      InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
}

model InventoryItem {
  id           String  @id @default(uuid())
  restaurantId String
  categoryId   String?

  name        String
  sku         String?
  description String?

  unit InventoryUnit

  currentStock Decimal @default(0) @db.Decimal(14, 3)
  reorderLevel Decimal @default(0) @db.Decimal(14, 3)

  costPerUnit Decimal @default(0) @db.Decimal(12, 2)

  isActive Boolean @default(true)

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category   InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  movements         StockMovement[]
  receiptItems      StockReceiptItem[]
  recipeIngredients RecipeIngredient[]
  stockDeductions   StockDeduction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, name])
  @@unique([restaurantId, sku])
  @@index([restaurantId, isActive])
  @@index([restaurantId, currentStock])
}

model Supplier {
  id           String @id @default(uuid())
  restaurantId String

  name    String
  phone   String?
  email   String?
  address String?

  isActive Boolean @default(true)

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  receipts   StockReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, name])
}

model StockReceipt {
  id           String  @id @default(uuid())
  restaurantId String
  supplierId   String?

  reference String?
  notes     String?

  status StockReceiptStatus @default(DRAFT)

  totalCost Decimal @default(0) @db.Decimal(14, 2)

  receivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  supplier   Supplier?  @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  items     StockReceiptItem[]
  movements StockMovement[]

  @@index([restaurantId, status, createdAt])
  @@index([supplierId])
}

model StockReceiptItem {
  id              String @id @default(uuid())
  receiptId       String
  inventoryItemId String

  quantity Decimal @db.Decimal(14, 3)
  unitCost Decimal @db.Decimal(12, 2)
  lineCost Decimal @db.Decimal(14, 2)

  receipt       StockReceipt  @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([inventoryItemId])
}

model StockMovement {
  id              String  @id @default(uuid())
  restaurantId    String
  inventoryItemId String
  receiptId       String?

  type StockMovementType

  quantity Decimal @db.Decimal(14, 3)

  stockBefore Decimal @db.Decimal(14, 3)
  stockAfter  Decimal @db.Decimal(14, 3)

  notes String?

  referenceId String?
  performedBy String?

  createdAt DateTime @default(now())

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  receipt       StockReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@index([restaurantId, createdAt])
  @@index([inventoryItemId, createdAt])
  @@index([receiptId])
}

model RecipeIngredient {
  id              String @id @default(uuid())
  menuItemId      String
  inventoryItemId String

  quantity Decimal @db.Decimal(14, 3)

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([menuItemId, inventoryItemId])
  @@index([inventoryItemId])
}

model StockDeduction {
  id              String @id @default(uuid())
  orderItemId     String
  inventoryItemId String

  quantity Decimal @db.Decimal(14, 3)

  deductedAt DateTime  @default(now())
  restoredAt DateTime?

  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, inventoryItemId])
  @@index([inventoryItemId])
}
