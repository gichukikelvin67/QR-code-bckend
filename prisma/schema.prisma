generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN
  BAR
  INVENTORY_MANAGER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum DiningSessionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderSource {
  QR
  WAITER
  POS
}

enum PreparationStation {
  KITCHEN
  BAR
}

enum PreparationStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum BillStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum PaymentMethod {
  MPESA
  CASH
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

model Restaurant {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  phone    String?
  email    String?
  isActive Boolean @default(true)

  memberships    Membership[]
  tables         RestaurantTable[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]
  bills          Bill[]
  payments       Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  memberships     Membership[]
  refreshSessions RefreshSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id           String         @id @default(uuid())
  userId       String
  restaurantId String
  role         MembershipRole
  isActive     Boolean        @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, restaurantId])
  @@index([restaurantId, role])
}

model RestaurantTable {
  id           String      @id @default(uuid())
  restaurantId String
  tableNumber  String
  capacity     Int         @default(2)
  status       TableStatus @default(AVAILABLE)
  qrToken      String      @unique @default(uuid())

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessions   DiningSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId, status])
}

model DiningSession {
  id      String              @id @default(uuid())
  tableId String
  status  DiningSessionStatus @default(OPEN)

  orders Order[]

  startedAt DateTime        @default(now())
  closedAt  DateTime?
  bills     Bill[]
  table     RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@index([tableId, status])
}

model RefreshSession {
  id           String    @id @default(uuid())
  userId       String
  restaurantId String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([restaurantId])
}

model MenuCategory {
  id           String  @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
}

model MenuItem {
  id           String  @id @default(uuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  price        Decimal @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable  Boolean @default(true)

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  station    PreparationStation @default(KITCHEN)

  @@index([restaurantId, isAvailable])
  @@index([categoryId, isAvailable])
}

model Order {
  id           String      @id @default(uuid())
  restaurantId String
  sessionId    String
  orderNumber  String
  source       OrderSource @default(QR)
  status       OrderStatus @default(PENDING)

  notes    String?
  subtotal Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  session    DiningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  items      OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status, createdAt])
  @@index([sessionId, status])
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String?

  // Snapshots preserve what the customer ordered,
  // even if the menu item is later renamed or removed.
  itemName  String
  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int
  notes     String?
  lineTotal Decimal @db.Decimal(12, 2)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  createdAt         DateTime           @default(now())
  preparationStatus PreparationStatus  @default(PENDING)
  station           PreparationStation @default(KITCHEN)
  billItems         BillItem[]

  @@index([orderId])
  @@index([menuItemId])
}

model Bill {
  id           String @id @default(uuid())
  restaurantId String
  sessionId    String

  billNumber String
  status     BillStatus @default(OPEN)

  subtotal   Decimal @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)
  amountPaid Decimal @default(0) @db.Decimal(12, 2)
  balance    Decimal @db.Decimal(12, 2)

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  session    DiningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  items    BillItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, billNumber])
  @@index([restaurantId, status, createdAt])
  @@index([sessionId, status])
}

model Payment {
  id           String @id @default(uuid())
  restaurantId String
  billId       String

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  amount Decimal @db.Decimal(12, 2)

  idempotencyKey    String
  reference         String?
  transactionId     String?   @unique
  checkoutRequestId String?   @unique
  merchantRequestId String?
  phoneNumber       String?
  failureReason     String?
  verifiedAt        DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  bill       Bill       @relation(fields: [billId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, status, createdAt])
  @@index([billId, status])
}

model BillItem {
  id          String @id @default(uuid())
  billId      String
  orderItemId String

  itemName  String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  bill      Bill      @relation(fields: [billId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([billId, orderItemId])
  @@index([orderItemId])
}
